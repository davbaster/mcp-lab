# Copy to .env (cp .env.example .env). Every value is a throwaway local default.

# Postgres user. Postgres reads POSTGRES_* only on first start; after changing them, run `docker compose down -v`.
POSTGRES_USER=mcp_lab

# Postgres password. Use only letters, digits, _ and - (other characters break $ interpolation and the connection URL in compose.yaml).
POSTGRES_PASSWORD=mcp_lab_dev_password

# Postgres database name.
POSTGRES_DB=mcp_lab

# Host port for Caddy, bound to 127.0.0.1. Change it if 8080 is already in use.
HTTP_PORT=8080

# DATABASE_URL is for running the backend natively (not in Docker). Format: postgresql+psycopg://user:password@host:port/dbname
# Percent-encode special characters in the password (@ becomes %40, % becomes %25). The backend does not read this file; set it in your shell.
# compose.yaml builds DATABASE_URL for the stack itself from the POSTGRES_* values above and turns on migrate-on-start, so do not set it here for Docker.
# DATABASE_URL=postgresql+psycopg://mcp_lab:mcp_lab_dev_password@127.0.0.1:5432/mcp_lab
