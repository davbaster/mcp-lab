{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Image",
  "description": "An image. The props of <Image ... /> in a lesson.",
  "type": "object",
  "required": ["src", "alt"],
  "additionalProperties": false,
  "properties": {
    "src": { "description": "The image URL.", "type": "string", "minLength": 1, "x-kind": "url" },
    "alt": { "description": "A text description of the image.", "type": "string", "minLength": 1 }
  },
  "x-children": "none"
}
