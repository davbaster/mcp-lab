{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Callout",
  "description": "A pinned copy for the rule tests, so they do not change when a real schema does.",
  "type": "object",
  "required": ["type"],
  "additionalProperties": false,
  "properties": {
    "type": { "type": "string", "enum": ["tip", "warning", "note"] },
