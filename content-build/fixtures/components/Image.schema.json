{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Image",
  "description": "A pinned copy for the rule tests, so they do not change when a real schema does.",
  "type": "object",
  "required": ["src", "alt"],
  "additionalProperties": false,
  "properties": {
    "src": { "type": "string", "minLength": 1, "x-kind": "url" },
    "alt": { "type": "string", "minLength": 1 }
  },
  "x-children": "none"
}
