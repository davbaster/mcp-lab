# The variables that caddy/mcp-lab.caddy reads. They are environment variables of the shared Caddy container on the VM
# (for example `env_file: /opt/proxy/mcp-lab.env` in the proxy's Compose project, which is set up outside this repo).
# Copy to that file and replace every CHANGE_ME. It holds no database secrets, only the staging login. Never commit it.
# A change takes effect when the Caddy container is recreated (docker compose up -d), not on a reload.

# The public domains. Their DNS records must point at the VM before Caddy can get their certificates.
MCP_LAB_PRODUCTION_DOMAIN=CHANGE_ME.example.com
MCP_LAB_STAGING_DOMAIN=staging.CHANGE_ME.example.com

# The gateway containers, by their name on the proxy network (PROXY_UPSTREAM in production.env and staging.env).
MCP_LAB_PRODUCTION_UPSTREAM=mcp-lab-production
MCP_LAB_STAGING_UPSTREAM=mcp-lab-staging

# Staging's HTTP basic auth login. The hash is bcrypt: docker exec caddy caddy hash-password
# Keep the hash in single quotes if the file is read by Docker Compose, so its $ signs are not interpolated.
MCP_LAB_STAGING_AUTH_USER=staging
MCP_LAB_STAGING_AUTH_HASH='CHANGE_ME_BCRYPT_HASH'
